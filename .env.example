# Sentry Error Tracking & Performance Monitoring
# Get your DSN from Sentry Dashboard -> Project Settings -> Client Keys (DSN)
VITE_SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/000000

# VAPID Public Key for Web Push Notifications (Optional)
VITE_VAPID_PUBLIC_KEY=

# Supabase Settings
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Sanity Settings
VITE_SANITY_PROJECT_ID=7yislksr
VITE_SANITY_DATASET=production
SANITY_WRITE_TOKEN=your-sanity-write-token

# Web3Forms API (Contact form)
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Cloudflare Turnstile (Anti-spam)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# YouTube Sync / Cron
YOUTUBE_API_KEY=your-youtube-api-key
CRON_SECRET=your-cron-secret
