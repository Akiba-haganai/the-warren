{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-warren",
  "main": "worker/index.ts",
  "keep_vars": true,
  "compatibility_date": "2026-07-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  // Sensitive runtime secrets (CRON_SECRET, SUPABASE_SERVICE_ROLE_KEY, YOUTUBE_API_KEY, SANITY_API_WRITE_TOKEN)
  // are stored as encrypted Cloudflare Worker Secrets and preserved across deploys via "keep_vars": true.
  "vars": {
    "SUPABASE_URL": "https://otdeonkfwghuevzhxrsy.supabase.co",
    "YOUTUBE_CHANNEL_ID": "UCGKgsxYNTUESqdvySiMIQ1A",
    "VITE_SANITY_PROJECT_ID": "7yislksr",
    "VITE_SANITY_DATASET": "production",
    "VITE_SUPABASE_URL": "https://otdeonkfwghuevzhxrsy.supabase.co",
    "VITE_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im90ZGVvbmtmd2dodWV2emh4cnN5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQwMjU2NzksImV4cCI6MjA5OTYwMTY3OX0.GcXKpB_99bVCQOtlJx8O9ttJxrL-kdP3XSEkCxkGaEs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
