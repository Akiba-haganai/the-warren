{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-warren",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
